# Port the service listens on (default 8085).
PORT=8085

# Shared service-to-service secret. When set, every request except /healthz
# and /source must send a matching `X-Internal-Auth` header. Leave unset to
# fail-open (useful for local dev). Matches the samwise/tool-service mesh.
SAMWISE_INTERNAL_SECRET=

# Public URL of this service's source, advertised to network users per AGPL-3.0.
SOURCE_URL=https://github.com/GAIINAPP/pine_runner
